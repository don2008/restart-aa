<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_bg" android:layout_width="match_parent"
        android:layout_height="match_parent" android:scaleType="fitXY"
        android:contentDescription="@null" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="18dp" android:paddingEnd="18dp">
        <ImageView android:layout_width="52dp" android:layout_height="44dp"
            android:src="@drawable/ic_jordan_red_real" android:scaleType="fitCenter"
            android:contentDescription="Červená basketbalová teniska" />
        <TextView android:id="@+id/steps_count" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginStart="14dp"
            android:text="—" android:textColor="#FFFFFF" android:textSize="26sp"
            android:textStyle="bold" />
        <TextView android:id="@+id/steps_label" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:text="krokov dnes"
            android:textColor="#F0FFFFFF" android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
